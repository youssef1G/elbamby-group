PORT=5000
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRES_IN=7d

GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Custom-domain SMTP (Zoho Mail recommended) — overrides the Gmail transport
# above when SMTP_HOST is set. SMTP_USER/SMTP_PASS fall back to GMAIL_*.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

FRONTEND_URL=http://localhost:5173

# WhatsApp Business Cloud API (optional) — points-change notifications.
# Leave WA_TOKEN/WA_PHONE_NUMBER_ID empty to fall back to email (SMTP above).
# Free tier: 1,000 service conversations/month. Setup: Meta Business Manager →
# WhatsApp → your number → API setup (access token + phone number ID); create
# the template below in the same Meta account and approve it.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Template must exist verbatim with 5 body params:
#   "Hello {{1}}, your BG points changed: {{2}} {{3}} pts. New balance: {{4}} pts. {{5}}"
# ({{2}} = gained/lost, {{3}} = amount, {{4}} = new balance, {{5}} = note/empty)
WA_TEMPLATE=bg_points_update
WA_TEMPLATE_LANG=en_US

RATE_LIMIT_WINDOW_MS=900000