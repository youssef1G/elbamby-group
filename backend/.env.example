PORT=5000
NODE_ENV=development

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRES_IN=7d

GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Custom-domain SMTP (Zoho Mail recommended) — overrides the Gmail transport
# above when SMTP_HOST is set. SMTP_USER/SMTP_PASS fall back to GMAIL_*.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

FRONTEND_URL=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000